// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Candidato {
  id              Int     @id @default(autoincrement())
  nombres         String
  apellidoPaterno String
  apellidoMaterno String
  aiScore         Int        @default(0)
  fotoUrl         String
  descripcionIA   String?    @db.Text 
  empleos         Empleos[]
  estudios        Estudios[]

  //relaciones
  idDepartamento Int?
  departamento Departamentos? @relation(fields: [idDepartamento], references: [id], onDelete: Cascade)

  idCargo               Int 
  cargo                 Cargo            @relation(fields: [idCargo], references: [id])
  idPartido             Int 
  partidoCandidato      Partido          @relation(fields: [idPartido], references: [id])
  analisisIA            AnalisisIA?
  antecedentesCandidato Antecedente[]
  documents Documents[]
  idNumeroCandidato Int
  numeroCandidato NumeroCandidato @relation(fields: [idNumeroCandidato], references: [id])

}


model NumeroCandidato{
  id Int @id @default(autoincrement())
  numero Int @unique
  candidatos Candidato[]
}


model Departamentos {
  id Int @id @default(autoincrement())
  nombre String
  ubigeo String
  candidatos Candidato[]

  
}

model Empleos {
  id      Int @id @default(autoincrement())
  nombre  String
  empresa String
  periodo String

  //relaciones
  idCandidato Int
  candidato   Candidato @relation(fields: [idCandidato], references: [id], onDelete: Cascade)
}

model Estudios {
  id             Int @id @default(autoincrement())
  nivelAcademico String
  centroEstudios String
  periodo        String
  carrera String?

  //relaciones
  idCandidato Int
  candidato   Candidato @relation(fields: [idCandidato], references: [id], onDelete: Cascade)
}



//cada candidato tiene muchos antecedentes y cada antecedente pertenece a un solo candidato- 1 a muchos
//esto se llena con ia
model Antecedente {
  id          Int @id @default(autoincrement())
  tipo        String
  asunto String
  descripcion String @db.Text
  
  idCandidato Int
  candidato   Candidato    @relation(fields: [idCandidato], references: [id], onDelete: Cascade)

  //Relación directa al documento fuente
  idDocumento Int?
  documento   Documents? @relation(fields: [idDocumento], references: [id], onDelete: SetNull)

  
}

//cada cargo pertenece a un muchos candidatos, uno a muchos. pero cada candidato tiene un solo cargo
model Cargo {
  id         Int @id @default(autoincrement()) 
  nombre     String  @unique
  slug       String  @unique
  candidatos Candidato[]
}

//cada partifo pertenece a muchos candidatos 1 a muchos
model Partido {
  id         Int @id @default(autoincrement()) @unique
  nombre     String @unique
  fotoUrl        String
  candidatos Candidato[]
}

enum Confianza {
  ALTA
  MEDIA
  BAJA
}

//analisa lo que hay en la tabla document_chunks, y saca un resumen con su resumen,
//puntuacion, confianza y me brinda la fuente de informacion
model AnalisisIA { //analisa los chunks, nos brinda la evaluacion de la ia
  id                  Int @id @default(autoincrement())
  score               Int       @default(0)
  resumen             String    @db.Text 
  confianza           Confianza
  fuentesUsadas       String[]
  ultimaActualizacion DateTime  @default(now())

  //relacion
  candidatoId         Int    @unique 
  candidato           Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

//alamacena los ducumentos enteros de un solo candidato, cada documento tendra su id
//te brinda la fecha de entrada o actualizacion de datos ---> createdAt
model Documents {
  id             Int @id @default(autoincrement()) @unique
  type           String
  content        String           @db.Text
  createdAt      DateTime         @default(now())
  fuente String

  // relación con tu modelo Candidato
  idCandidato Int 
  candidato   Candidato @relation(fields: [idCandidato], references: [id], onDelete: Cascade)

   // ← NUEVO: Antecedentes que vienen de este documento
  antecedentes Antecedente[]
  
  // Chunks de este documento
  chunks       DocumentChunks[]


}

//cada chunk pertenece a un solo documento y a un solo candidato. cada chunk tiene su contenido que es un trozo de texto
//
model DocumentChunks {
  id        Int @id @default(autoincrement())
  content   String    @db.Text
  
  // campo vector (NO soportado directamente por Prisma)
  embedding Unsupported("vector(1536)")?

  //relacion con el documento al que extraemos el chunk
  documentId      Int
  destinoDocument Documents @relation(fields: [documentId], references: [id], onDelete: Cascade)
  

  
  

  
}
