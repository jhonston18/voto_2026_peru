// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Candidato {
  id                    String        @id @default("gen_random_uuid()") @db.Uuid
  nombres               String
  apellidos             String
  aiScore               Int           @default(0)
  fotoUrl               String
  cargoId               String
  cargo                 Cargo         @relation(fields: [cargoId], references: [id])
  analisisIA            AnalisisIA?
  idPartido             String
  partidoCandidato      Partido       @relation(fields: [idPartido], references: [id])
  antecedentesCandidato Antecedente[]
  documents             Documents[]
  document_chunks       document_chunks[]
}

enum DocumentType {
  PENAL
  POLICIAL
  PLAN_DE_GOBIERNO
  HOJA_DE_VIDA
  OTROS
}

model Antecedente {
  id          String       @id @default("gen_random_uuid()") @db.Uuid
  tipo        DocumentType
  descripcion String
  candidatoId String
  candidato   Candidato    @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

model Cargo {
  id         String      @id @default("gen_random_uuid()") @db.Uuid
  nombre     String      @unique
  slug       String      @unique
  candidatos Candidato[]
}

model Partido {
  id          String      @id @default("gen_random_uuid()") @db.Uuid
  nombre      String
  idcandidato String
  candidatos  Candidato[]
}

enum Confianza {
  ALTA
  MEDIA
  BAJA
}

model AnalisisIA {
  id                  String    @id @default("gen_random_uuid()") @db.Uuid
  candidatoId         String    @unique
  candidato           Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  score               Int       @default(0)
  resumen             String    @db.Text
  confianza           Confianza
  fuentesUsadas       String[]
  ultimaActualizacion DateTime  @default(now())
}

model Documents {
  id           String    @id @default("gen_random_uuid()") @db.Uuid
  candidate_id String
  candidate    Candidato @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  type         String
  content      String    @db.Text
  created_at   DateTime  @default(now())
}

model document_chunks {
id String @id @default("gen_random_uuid()") @db.Uuid
document_id String
content String @db.Text
candidatoId String
embedding Unsupported("vector(1536)")?
candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

}